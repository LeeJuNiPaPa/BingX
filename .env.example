TELEGRAM_ALLOWED_USER_IDS=

# Default Trading Config
DEFAULT_SPLIT_COUNT=10
DEFAULT_MARGIN_TYPE=ISOLATED

# Optional AI LLM Keys for Unlimited General Chat (OpenAI / Gemini)
OPENAI_API_KEY=
